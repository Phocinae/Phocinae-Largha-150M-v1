{
  "name": "flip 五组复现配方 · 重排种子表（Phocinae-Largha-150M-v1 选项序翻转护栏）",
  "protocol": "每个评测 case 的每个 choice 型问题做 5 组选项顺序预测：组1 原序（不重排，对照基线）+ 组2 全反序 + 组3-5 随机排列（种子 0/1/2）。比较 chosen label 与原序是否一致，不一致即计一次 flip。",
  "rng": "python random.Random(seed)；逐 case 对 choice.criteria 的 items 做 rng.shuffle；与 eval_flip --rand-seed 语义逐位一致（每 seed 一个顺序 rng）。",
  "groups": [
    {
      "group": 1,
      "name": "original",
      "name_zh": "原序",
      "mode": "identity",
      "seed": null,
      "note": "对照基线，不重排"
    },
    {
      "group": 2,
      "name": "reversed",
      "name_zh": "全反序",
      "mode": "reverse",
      "seed": null,
      "note": "criteria = dict(reversed(list(criteria.items())))"
    },
    {
      "group": 3,
      "name": "random",
      "name_zh": "随机排列",
      "mode": "random_permutation",
      "seed": 0,
      "note": "random.Random(0) 逐 case shuffle"
    },
    {
      "group": 4,
      "name": "random",
      "name_zh": "随机排列",
      "mode": "random_permutation",
      "seed": 1,
      "note": "random.Random(1) 逐 case shuffle"
    },
    {
      "group": 5,
      "name": "random",
      "name_zh": "随机排列",
      "mode": "random_permutation",
      "seed": 2,
      "note": "random.Random(2) 逐 case shuffle"
    }
  ],
  "perm_seeds": [
    0,
    1,
    2
  ],
  "metrics": {
    "rev": "flip_rate_reversed = count(原序 chosen != 全反序 chosen) / n_choice",
    "random_mean": "flip_rate_random_mean = sum(per_seed[s] for s in seeds) / len(seeds)；per_seed[s] = count(原序 != seed-s 随机排列) / n_choice",
    "any": "flip_rate_random_any = count(存在至少 1 个 seed 使 chosen != 原序) / n_choice（union 口径，按问题计）"
  },
